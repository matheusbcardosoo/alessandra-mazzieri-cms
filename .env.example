# =====================================================
# VPS/PRODUCTION CONFIGURATION
# =====================================================
# Copy this file to .env and fill real values.
# This root .env is used by Node/Express (server runtime).

# Server
NODE_ENV=production
# PORT is usually injected by the VPS/process manager.
# Keep empty unless your environment requires a fixed port.
# PORT=4000
DATABASE_URL="postgresql://user:password@host:5432/database"
JWT_SECRET="generate_a_secure_random_secret_min_16_chars"
SUPABASE_URL="https://yourproject.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
SUPABASE_STORAGE_BUCKET="site-media"
REDIS_URL="redis://:redis_password@localhost:6379" # optional
# For local dev, REDIS_URL's password must match REDIS_PASSWORD below —
# docker-compose.yml starts the local Redis container with --requirepass
# whenever REDIS_PASSWORD is non-empty, and dotenv does not expand variables,
# so the two are not auto-synced. In production, replace REDIS_URL with your
# managed Redis instance's full connection string (e.g. "rediss://:pass@redis-host:6379")
# and REDIS_PORT/REDIS_PASSWORD are ignored (docker-compose isn't used there).
REDIS_PORT=6379
REDIS_PASSWORD="redis_password"
REDIS_PREFIX="web-cms-template"
CACHE_TTL_NAV=3600
CACHE_TTL_HOME=3600
CACHE_TTL_PAGE=600
CACHE_TTL_POST=600
CACHE_TTL_POSTS_LIST=600
CACHE_TTL_VIEW_DEDUPE=1800
UPLOAD_MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_MIME_TYPES="image/jpeg,image/png,image/webp"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change_this_in_production"

# SEO / AI-readiness (Fase 4)
# Canonical public URL (no trailing slash). Used in robots.txt, sitemap.xml,
# llms.txt and the www/non-www 301 redirect.
SITE_URL="https://yourdomain.com"
# "true" allows AI crawlers to use site content for model training
# (Content-Signal: ai-train in robots.txt). Search indexing and AI agent
# use (RAG/answers) are always allowed regardless of this flag.
AI_TRAINING_ALLOWED=false

# Nível dos logs estruturados (pino): fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Error tracking (Sentry) — optional. Without it the app runs identically,
# it just doesn't report exceptions anywhere.
SENTRY_DSN=

# Frontend (Vite) variables:
# Put these in client/.env.production (or client/.env) before running build.
# VITE_API_URL controls API endpoint used by frontend.
# - Same domain deployment: /api
# - Separate API domain: https://api.yourdomain.com/api
# VITE_PUBLIC_URL controls the "View site" public URL in admin.
# - Example: https://yourdomain.com
